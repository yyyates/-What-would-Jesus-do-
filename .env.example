# Copy this file to .env for running on your own computer. Never commit .env or share your key.
ANTHROPIC_API_KEY=
# Optional settings
MODEL=claude-haiku-5-5
FREE_PER_DAY=10
DAILY_QUESTION_CAP=2000
DONATE_URL=
SITE_NAME=What Would Jesus Do
# Premium with Stripe (leave blank to hide Premium)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Any long random string; keeps Premium codes from being forged
SESSION_SECRET=
PREMIUM_PER_DAY=100
# Check-in reminders (leave blank to hide). See README "Set up check-in reminders".
# Push notifications: run `npm run vapid-keys` once and paste both keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email via Resend (resend.com)
RESEND_API_KEY=
EMAIL_FROM=What Would Jesus Do <hello@yourdomain.com>
# Where subscribers are saved (upstash.com, free). Without these, a local file is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; the hourly scheduler sends it to trigger reminders
CRON_SECRET=
# Your site's address, used in email links (e.g. https://whatwouldjesusdo.app)
PUBLIC_URL=
